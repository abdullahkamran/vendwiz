# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vendwiz
# Production (Supabase): Project → Connect → "Session pooler" string, plus ?sslmode=require.
# Not the "Direct connection" (IPv6 only; Docker containers usually can't reach it) and not the
# "Transaction pooler" on port 6543 (no prepared statements). The user name is postgres.<project-ref>:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API (optional — enables auto-send; without this only wa.me links work)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# File uploads
# local = save under UPLOAD_DIR (dev); s3 = S3-compatible bucket (Cloudflare R2) served from CDN_BUCKET_BASE_URL
STORAGE_DRIVER=local
UPLOAD_DIR=static/uploads
# Only used when STORAGE_DRIVER=s3. R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the app's folder in the bucket. Its path is the folder files are uploaded into, so
# this one stores <storeId>/<folder>/<id>.webp under "vendwiz/". The DB keeps only <storeId>/…, so
# switching to another domain (e.g. from https://pub-<hash>.r2.dev/vendwiz) is just this value.
CDN_BUCKET_BASE_URL=https://cdn.11devs.com/vendwiz

# App
# PUBLIC_APP_URL and VITE_ROOT_DOMAIN are compiled into the build: set them before `pnpm build`
# (as Docker build args), not only at runtime. Everything else is read when the server starts.
PUBLIC_APP_URL=http://localhost:5173
# Root domain for subdomain routing
VITE_ROOT_DOMAIN=vendwiz.com

# Production server (adapter-node, `node build`) — not used by `pnpm dev`. The Dockerfile sets these.
# Don't set ORIGIN: it pins one origin for every request, which breaks storefront forms on
# <store>.<root domain> ("Cross-site POST form submissions are forbidden"). The host comes from the
# Host header, which Cloudflare passes through unchanged.
# PROTOCOL_HEADER=x-forwarded-proto
# Max request body. The default (512K) rejects most image uploads; the app itself allows images up to 10MB
# BODY_SIZE_LIMIT=15M
# PORT=3000

# Production with docker-compose.yml only
# Cloudflare Tunnel token: Zero Trust → Networks → Tunnels → Create → Cloudflared → copy the token
CLOUDFLARE_TUNNEL_TOKEN=
# Daily database dumps (scripts/backup.sh). Use a separate PRIVATE R2 bucket — never the public media
# bucket. Endpoint and keys default to S3_ENDPOINT / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY; the R2
# token used must have write access to this bucket.
BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Set to false to turn off all outgoing email (default: on)
EMAIL_ENABLED=true

# Email (SMTP) — one platform sender for all stores. Each email shows the store's name as the
# sender and uses the store's contact email as Reply-To.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="VendWiz <you@example.com>"
